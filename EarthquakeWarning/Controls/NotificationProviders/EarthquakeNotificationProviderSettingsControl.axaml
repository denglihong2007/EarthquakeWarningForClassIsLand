<ci:NotificationProviderControlBase
    x:Class="EarthquakeWarning.Controls.NotificationProviders.EarthquakeNotificationProviderSettingsControl"
    x:TypeArguments="models:EarthquakeNotificationSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="clr-namespace:EarthquakeWarning.Controls.NotificationProviders"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:models="clr-namespace:EarthquakeWarning.Models"
    mc:Ignorable="d"
    d:DesignHeight="560" d:DesignWidth="450">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:EarthquakeNotificationProviderSettingsControl}}">

            <ui:InfoBar Title="免责声明"
                        Margin="0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="地震预警信息通过小米 MIUI 地震预警服务提供。作者不对信息的准确性、有效性、及时性作承诺和保证。" />

            <TextBlock Text="服务状态"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <ui:SettingsExpander Header="运行状态"
                                 Margin="0"
                                 IconSource="Cloud"
                                 Description="{Binding Settings.ServerInfo}">
                <ui:SettingsExpanderItem Content="当前数据"
                                         Description="{Binding Settings.Info}" />
            </ui:SettingsExpander>

            <TextBlock Text="预警配置"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <ui:SettingsExpander Header="地理位置"
                                 Margin="0"
                                 IconSource="Target"
                                 Description="用于计算本地烈度和预计到达时间"
                                 IsExpanded="True">
                <ui:SettingsExpander.Footer>
                    <Button Content="自动定位"
                            Click="btnLocate_Click"
                            x:Name="btnLocate" />
                </ui:SettingsExpander.Footer>

                <ui:SettingsExpanderItem Content="纬度">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.Latitude}"
                                       Minimum="-90" Maximum="90"
                                       Increment="0.001"
                                       FormatString="0.######" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="经度">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.Longitude}"
                                       Minimum="-180" Maximum="180"
                                       Increment="0.001"
                                       FormatString="0.######" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:InfoBar x:Name="locationErrorInfoBar"
                        Margin="0"
                        Title="无法自动定位"
                        Message="请确认系统位置服务已开启，并允许 ClassIsland 访问位置信息。"
                        Severity="Warning"
                        IsOpen="False"
                        IsClosable="True" />

            <ui:SettingsExpander Header="烈度阈值"
                                 Margin="0"
                                 IconSource="Filter"
                                 Description="本地预估烈度超过该值时弹出提醒">
                <ui:SettingsExpander.Footer>
                    <NumericUpDown Width="150"
                                   Value="{Binding Settings.Threshold}"
                                   Minimum="0" Maximum="12"
                                   Increment="0.1"
                                   FormatString="0.0" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="倒计时语音"
                                 Margin="0"
                                 IconSource="Volume"
                                 Description="预警开始时自动提高系统音量；10 秒前每 2 秒播报一次，最后 10 秒逐秒播报">
                <ui:SettingsExpanderItem Content="启用语音播报">
                    <ui:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsSpeechEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="播报阈值"
                                         Description="与提醒阈值相互独立">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.SpeechThreshold}"
                                       Minimum="0" Maximum="12"
                                       Increment="0.1"
                                       FormatString="0.0"
                                       IsEnabled="{Binding Settings.IsSpeechEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="预警动作"
                                 Margin="0"
                                 IconSource="Code"
                                 Description="{Binding Settings.ActionStatus}">
                <ui:SettingsExpanderItem Content="执行 CMD 命令"
                                         Description="每个地震事件执行一次">
                    <ui:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsCommandEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="命令">
                    <ui:SettingsExpanderItem.Footer>
                        <TextBox Width="260"
                                 Text="{Binding Settings.Command}"
                                 IsEnabled="{Binding Settings.IsCommandEnabled}"
                                 Watermark="例如: shutdown /s /t 60" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <TextBlock Text="调试与测试"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <ui:SettingsExpander Header="预警演练"
                                 Margin="0"
                                 IconSource="Play"
                                 Description="模拟一次地震预警，检查提醒和倒计时语音"
                                 ActionIconSource="ChevronRight"
                                 IsClickEnabled="True"
                                 x:Name="btnExample"
                                 Click="btnExample_Click" />
        </StackPanel>
    </ScrollViewer>
</ci:NotificationProviderControlBase>
